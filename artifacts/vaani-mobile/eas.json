      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_DOMAIN": "askvaani.org"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6787778755"
      }
    }
  }
}
