{
  "expo": {
    "name": "Vaani",
    "slug": "vaani-mobile",
    "owner": "your-voice-first",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vaani-mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf8f4"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.replit.vaani",
      "buildNumber": "8",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Vaani uses speech recognition to turn what you say into text for your questions and notes.",
        "NSMicrophoneUsageDescription": "Vaani uses the microphone so you can speak your questions and notes instead of typing."
      }
    },
    "android": {
      "package": "com.yourvoicefirst.vaani",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#c4d2da"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.VIBRATE"
      ],
      "blockedPermissions": [
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Vaani uses the microphone so you can speak your questions and notes instead of typing.",
          "speechRecognitionPermission": "Vaani uses speech recognition to turn what you say into text for your questions and notes.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Vaani lets you attach a photo of a lab report or medical document so it can suggest questions to ask your doctor.",
          "cameraPermission": "Vaani uses the camera so you can take a photo of a lab report or medical document to get suggested questions."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "11cf007a-9a15-4559-b471-14eb60c22017"
      }
    }
  }
}
